# Copy this file to `.env` (or `.env.local`) to change settings. Every value has a safe default,
# so the app also runs without a .env file.
# Only variables that start with VITE_ are exposed to the browser. Never put secrets here.

# Base URL that every API request is sent to.
VITE_API_BASE_URL=/api

# "true" starts the mock API (MSW) in the browser, so no real backend is needed.
VITE_ENABLE_MOCKS=true

# WebSocket for live stock updates. Default: ws(s)://<current host>/ws/stock
# VITE_STOCK_FEED_URL=wss://example.com/ws/stock
